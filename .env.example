# Copiar a .env o exportar en el shell. No commitear secretos reales.

JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SEED_USER_PASSWORD=user123
SEED_ADMIN_PASSWORD=admin123
SPRING_PROFILES_ACTIVE=local

# Prod / Fly (setear en `fly secrets set`, no en el repo).
# Con el perfil prod la app no arranca si JWT_SECRET falta o es el default de application.yml.
# SPRING_PROFILES_ACTIVE=prod
# JWT_SECRET=...
# H2_FILE_PATH=/data/challenge
# PORT=8080
