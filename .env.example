# Copiar a .env o exportar en el shell. No commitear secretos reales.

JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SEED_USER_PASSWORD=user123
SEED_ADMIN_PASSWORD=admin123
SPRING_PROFILES_ACTIVE=local

# Solo si usás un Postgres local opcional (no requerido; local/prod usan H2).
# DATABASE_URL=jdbc:postgresql://localhost:5432/challenge
# DATABASE_USERNAME=challenge
# DATABASE_PASSWORD=challenge

# Prod / Fly (setear en `fly secrets set`, no en el repo):
# SPRING_PROFILES_ACTIVE=prod
# JWT_SECRET=...
# H2_FILE_PATH=/data/challenge
# PORT=8080
